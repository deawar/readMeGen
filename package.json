{
  "name": "readmegen",
  "version": "1.0.0",
  "description": "Electron desktop app to autogenerate a README.md from GitHub project info",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "cli": "node src/cli/index.js",
    "lint": "standard",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "icons": "node scripts/make-icons.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deawar/readMeGen.git"
  },
  "author": {
    "name": "Dean Warren",
    "email": "deawar@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "chalk": "^5.0.1",
    "dompurify": "^3.4.17",
    "dotenv": "^16.0.1",
    "figlet": "^1.5.2",
    "inquirer": "^9.0.0",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.0.0",
    "open": "^8.4.0"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "png2icons": "^2.0.1",
    "pureimage": "^0.4.20",
    "standard": "^17.0.0"
  },
  "build": {
    "appId": "com.deawar.readmegen",
    "productName": "readMeGen",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        },
        {
          "target": "zip",
          "arch": "universal"
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "publish": {
      "provider": "github",
      "owner": "deawar",
      "repo": "readMeGen",
      "releaseType": "draft"
    }
  }
}
